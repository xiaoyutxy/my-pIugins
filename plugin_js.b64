        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(245, 158, 11, .15);
    }
   #battery_ring, #header_ring_path {
        transition: stroke-dashoffset 0.3s cubic-bezier(0.25, 1, 0.5, 1); //圆环特效
