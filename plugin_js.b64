            { url: function(id) { return 'http://103.79.184.97/api/music/url?source=wy&songId=' + id + '&quality=320k&key=MOLAN-BAIJI' }, extract: [['url'],['data','url']], headers: 'X-Card-Key: MOLAN-BAIJI' },
            // 8. 长青SVIP
